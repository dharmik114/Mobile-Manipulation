<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobman">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mobman urdf file -->
    <xacro:include filename="$(find mobman_description)/urdf/mobman.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="mobman.ros2_control.xacro" />


    <xacro:mobman_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
