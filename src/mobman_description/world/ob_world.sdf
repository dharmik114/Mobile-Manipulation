<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="simple_lightweight_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="wall_north">
        <pose>2.5 0 0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></visual>
      </link>
      <link name="wall_south">
        <pose>-2.5 0 0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></visual>
      </link>
      <link name="wall_east">
        <pose>0 2.5 0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.0 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.1 0.5</size></box></geometry></visual>
      </link>
      <link name="wall_west">
        <pose>0 -2.5 0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.0 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="box_obs_1">
      <pose>1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="cyl_obs_1">
      <pose>-1.5 1.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="box_obs_2">
      <pose>-1.0 -1.5 0.25 0 0 0.7</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.8 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.8 0.5</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>